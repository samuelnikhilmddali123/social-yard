
# E3DI Edge Agent Environment Configuration
# Store camera credentials EXCLUSIVELY at the edge. Never expose to cloud or frontend.

CLOUD_SERVER_URL=https://api.e3di.org
EDGE_ID=EDGE-001
SITE_ID=SITE-001
AGENT_NAME="Site 001 CCTV Gateway"
AGENT_VERSION=1.0.0

# Local LAN Camera Configuration (Edge ONLY)
CAMERA_HOST=192.168.1.108
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=admin
CAMERA_PASSWORD="<SECRET_PASSWORD>"
CAMERA_MAIN_STREAM=/avstream/channel=1/stream=0.sdp
CAMERA_SUB_STREAM=/avstream/channel=1/stream=1.sdp

# Idle Stream Timeout (seconds)
CAMERA_SESSION_IDLE_TIMEOUT=60
