          "location": { "type": "string" },
          "status": { "type": "string" },
          "soundEnabled": { "type": "boolean" },
          "volume": { "type": "integer" }
        }
      },
      "EdgeAgent": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "edgeId": { "type": "string" },
          "siteId": { "type": "string" },
          "name": { "type": "string" },
          "agentVersion": { "type": "string" },
          "status": { "type": "string", "enum": ["online", "offline"] },
          "lastSeen": { "type": "string", "format": "date-time" },
