          "startTime": { "type": "string" },
          "endTime": { "type": "string" }
        }
      },
      "VideoMedia": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "thumbnailUrl": { "type": "string" },
          "mediaType": { "type": "string" },
          "fileSize": { "type": "integer" }
        }
      }
    }
  }
