            "type": "object",
            "properties": {
              "cpuUsage": { "type": "number" },
              "memoryUsage": { "type": "number" },
              "activeStreams": { "type": "integer" }
            }
          }
        }
      },
      "Camera": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "siteId": { "type": "string" },
          "name": { "type": "string" },
          "vendor": { "type": "string" },
          "status": { "type": "string" },
          "hlsUrl": { "type": "string" }
        }
      },
      "SosAlert": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "device": { "type": "string" },
          "status": { "type": "string" },
          "battery": { "type": "number" },
          "poleId": { "type": "string" },
          "location": { "type": "string" },
          "resolved": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
