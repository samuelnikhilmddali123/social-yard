        "type": "object",
        "properties": {
          "corridorId": { "type": "string" },
          "corridorName": { "type": "string" },
          "pricePer5Sec": { "type": "number" },
          "pricePer30Sec": { "type": "number" },
          "pricePerScreen": { "type": "number" },
          "city": { "type": "string" },
          "area": { "type": "string" }
        }
      },
      "Screen": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "deviceId": { "type": "string" },
          "name": { "type": "string" },
          "location": { "type": "string" },
          "corridorName": { "type": "string" },
          "poleId": { "type": "string" },
          "side": { "type": "string" },
          "status": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "soundEnabled": { "type": "boolean" },
          "volume": { "type": "integer" }
        }
      },
      "ScreenInput": {
        "type": "object",
        "required": ["deviceId", "name", "location", "lat", "lng"],
        "properties": {
          "deviceId": { "type": "string" },
          "name": { "type": "string" },
          "location": { "type": "string" },
          "corridorName": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" }
        }
      },
      "Billboard": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "location": { "type": "string" },
          "status": { "type": "string" },
          "price": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" }
        }
      },
      "BillboardInput": {
        "type": "object",
        "required": ["location", "price", "lat", "lng"],
        "properties": {
          "location": { "type": "string" },
          "price": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" }
        }
      },
