# LED Screens Server Configuration (CPU Server Build with Cloudflare)

PORT=5000
MONGODB_URI=mongodb://localhost:27017/ledscreens
JWT_SECRET=your_super_secret_jwt_key_here

# Server & Cloudflare CDN Configuration
SERVER_URL=https://api.e3di.org
CLOUDFLARE_CDN_URL=https://api.e3di.org
CLOUDFLARE_PUBLIC_URL=https://api.e3di.org

# Telegram Bot Instant Notification Configuration
# 1. Create bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your numeric Chat ID via @userinfobot to get your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Sparsh CCTV Live Camera Configuration
CAMERA_ENABLED=true
CAMERA_HOST=192.168.1.108
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_camera_password_here
CAMERA_MAIN_STREAM=/avstream/channel=1/stream=0.sdp
CAMERA_SUB_STREAM=/avstream/channel=1/stream=1.sdp
CAMERA_MODEL=SC-INA50B-3P25

