{
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build && cd .. && mkdir -p dist && cp -r frontend/dist/* dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/_/backend/api/(.*)", "destination": "/api/index.js" },
    { "source": "/_/backend/(.*)", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
